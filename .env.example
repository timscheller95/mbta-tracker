# ── Datadog (required) ────────────────────────────────────────────────────────
# A Datadog Service Access Token (SAT) — create one at:
# app.datadoghq.com → Organization Settings → Service Access Tokens
DD_SAT=

# Datadog site. Default is US1. Change if your org is on a different region:
#   EU:  datadoghq.eu
#   US3: us3.datadoghq.com
#   US5: us5.datadoghq.com
DD_SITE=datadoghq.com

# ── ntfy.sh topics (required) ─────────────────────────────────────────────────
# Topics are public on ntfy.sh — use long, random strings to prevent others from
# subscribing. Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# Subscribe on your phone via the ntfy app: https://ntfy.sh/app
NTFY_TOPIC_WIFE=
NTFY_TOPIC_SELF=

# ── Optional ──────────────────────────────────────────────────────────────────
# How often to poll the MBTA API, in seconds. Default: 60
# The anonymous MBTA API limit is 20 req/min; at 60s this uses ~2-4 req/min.
POLL_INTERVAL_SECONDS=60

# Minimum delay (seconds) before prediction-based alerts fire. Default: 600 (10 min)
# Official MBTA disruption alerts (NO_SERVICE, SUSPENSION, etc.) always fire
# regardless of this threshold.
DELAY_THRESHOLD_SECONDS=600

# Override the Datadog OTLP endpoint if you are on a non-US1 region:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.datadoghq.eu/api/intake/otlp
