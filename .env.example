# ── Datadog (required) ────────────────────────────────────────────────────────
# Your Datadog API key — find it at app.datadoghq.com → Organization Settings → API Keys
DD_API_KEY=

# Datadog site. Default is US1. Change if your org is on a different region:
#   EU:  datadoghq.eu
#   US3: us3.datadoghq.com
#   US5: us5.datadoghq.com
DD_SITE=datadoghq.com

# ── Optional ──────────────────────────────────────────────────────────────────
# How often to poll the MBTA API, in seconds. Default: 60
# The anonymous MBTA API limit is 20 req/min; at 60s this uses ~2 req/min.
POLL_INTERVAL_SECONDS=60
