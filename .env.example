# ── MBTA ──────────────────────────────────────────────────────────────────────
# Free API key from https://api-v3.mbta.com/
# Without a key the API still works but is rate-limited to 20 req/min.
MBTA_API_KEY=

# How often to poll the MBTA API (seconds). Default: 30
POLL_INTERVAL_SECONDS=30

# ── Datadog ───────────────────────────────────────────────────────────────────
# Your Datadog API key (required for dual-shipping to Datadog)
DD_API_KEY=
# Datadog site (default: datadoghq.com | EU: datadoghq.eu)
DD_SITE=datadoghq.com

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=mbta-tracker

# ── General ───────────────────────────────────────────────────────────────────
DEPLOYMENT_ENV=development
