# ── Datadog ───────────────────────────────────────────────────────────────────
# Your Datadog Personal Access Token. This is NOT used by the tracker container
# directly — it is the credential you supply as DD_API_KEY when installing the
# Datadog Agent natively on the Pi. The Agent then handles all Datadog auth.
#
# Install the Agent on Pi OS (run once, as root):
#   DD_API_KEY=<your-token> DD_SITE=datadoghq.com \
#     bash -c "$(curl -L https://s3.amazonaws.com/dd-agent-bootstrap/datadog_agent7_raspberry.sh)"
#
# Then enable the OTLP HTTP receiver in /etc/datadog-agent/datadog.yaml:
#   otlp_config:
#     receiver:
#       protocols:
#         http:
#           endpoint: localhost:4318
#
# Restart the agent: sudo systemctl restart datadog-agent
DD_PAT=

# ── ntfy.sh topics (required) ─────────────────────────────────────────────────
# Topics are public on ntfy.sh — use long random strings so others can't subscribe.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# Subscribe on your phone via the ntfy app: https://ntfy.sh/app
NTFY_TOPIC_WIFE=
NTFY_TOPIC_SELF=

# ── Optional ──────────────────────────────────────────────────────────────────
# Poll interval in seconds. Default: 60. Anonymous MBTA API limit: 20 req/min.
POLL_INTERVAL_SECONDS=60

# Minimum prediction delay before alerting. Default: 600 (10 min).
# Official MBTA disruption alerts (NO_SERVICE, SUSPENSION, etc.) always fire
# regardless of this threshold.
DELAY_THRESHOLD_SECONDS=600

# Override the OTLP endpoint if the Datadog Agent is on a different host.
# Default: http://localhost:4318 (Agent's local HTTP receiver via host network).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
