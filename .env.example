# ── Datadog ───────────────────────────────────────────────────────────────────
# Datadog API key — find or create one under Organization Settings → API Keys.
# Used when installing the native Agent on the Pi (see README) and by the
# Agent sidecar in docker-compose.dev.yml.
DD_API_KEY=

# ── ntfy.sh topics (required) ─────────────────────────────────────────────────
# Topics are public on ntfy.sh — use long random strings so others can't subscribe.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# Subscribe on your phone via the ntfy app: https://ntfy.sh/app
NTFY_TOPIC_1=
NTFY_TOPIC_2=

# ── Optional ──────────────────────────────────────────────────────────────────
# Poll interval in seconds. Default: 60. Anonymous MBTA API limit: 20 req/min.
POLL_INTERVAL_SECONDS=60

# Minimum prediction delay before alerting. Default: 600 (10 min).
# Official MBTA disruption alerts (NO_SERVICE, SUSPENSION, etc.) always fire
# regardless of this threshold.
DELAY_THRESHOLD_SECONDS=600
