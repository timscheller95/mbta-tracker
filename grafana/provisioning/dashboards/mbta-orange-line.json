{
  "annotations": {
    "list": []
  },
  "description": "Rider-focused Orange Line dashboard: delays, stop impacts, headways, and live train positions. Powered by MBTA V3 API + OpenTelemetry.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Real-time positions of all active Orange Line trains. Blue = northbound (Oak Grove), green = southbound (Forest Hills). Updates every 30 seconds.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e05c17",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "direction"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "northbound": {
                        "color": "blue",
                        "index": 0,
                        "text": "Northbound"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "southbound": {
                        "color": "green",
                        "index": 1,
                        "text": "Southbound"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "unknown": {
                        "color": "gray",
                        "index": 2,
                        "text": "Unknown"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 20,
      "options": {
        "basemap": {
          "config": {},
          "name": "Layer 0",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "field": "direction",
                  "mode": "field"
                },
                "opacity": 1,
                "size": {
                  "fixed": 8,
                  "max": 15,
                  "min": 4
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                },
                "symbolAlign": {
                  "h": "center",
                  "v": "center"
                },
                "text": {
                  "field": "label",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": -14
                }
              }
            },
            "name": "Orange Line Trains",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "id": "coords",
          "lat": 42.37,
          "lon": -71.09,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mbta_vehicle_latitude_deg{route=\"Orange\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "Lat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mbta_vehicle_longitude_deg{route=\"Orange\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "Lng"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "vehicle_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "route": true,
              "route 1": true,
              "label 1": true,
              "direction 1": true,
              "status 1": true
            },
            "renameByName": {
              "Value #Lat": "latitude",
              "Value #Lng": "longitude"
            }
          }
        }
      ],
      "title": "Live Train Positions",
      "type": "geomap"
    },
